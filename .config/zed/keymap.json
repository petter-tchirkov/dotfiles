[
	{
		"context": "Editor && (vim_mode == normal || vim_mode == visual) && !VimWaiting && !menu",
		"bindings": {
			"space 1": [
				"pane::ActivateItem",
				0
			],
			"space 2": [
				"pane::ActivateItem",
				1
			],
			"space 3": [
				"pane::ActivateItem",
				2
			],
			"space 4": [
				"pane::ActivateItem",
				3
			],
			"space 5": [
				"pane::ActivateItem",
				4
			],
			"space 6": [
				"pane::ActivateItem",
				5
			],
			"space 7": [
				"pane::ActivateItem",
				6
			],
			"space 8": [
				"pane::ActivateItem",
				7
			],
			"space 9": [
				"pane::ActivateItem",
				8
			],
			"space 0": "pane::ActivateLastItem"
		}
	},
	{
		"context": "VimControl && !menu",
		"bindings": {
			"ctrl-h": "workspace::ActivatePaneLeft",
			"ctrl-l": "workspace::ActivatePaneRight",
			"ctrl-k": "workspace::ActivatePaneUp",
			"ctrl-j": "workspace::ActivatePaneDown",
			"shift-h": "pane::ActivatePreviousItem",
			"shift-l": "pane::ActivateNextItem",
			"shift-k": "editor::Hover",
			"alt-j": "vim::ScrollDown",
			"alt-k": "vim::ScrollUp",
			"s": [
				"vim::PushSneak",
				{}
			],
			"S": [
				"vim::PushSneakBackward",
				{}
			],
			"space w": "workspace::Save",
			"space x": "pane::CloseActiveItem",
			"space l a": "editor::ToggleCodeActions",
			"space l f": "editor::Format",
			"space l h": "editor::ToggleInlayHints",
			"space l r": "editor::Rename",
			"space l d": "diagnostics::Deploy",
			"space space": "tab_switcher::Toggle",
			"g r": "editor::FindAllReferences",
			"g d": "editor::GoToDefinition",
			"g D": "editor::GoToDefinitionSplit",
			"space f f": "file_finder::Toggle",
			"space f g": "pane::DeploySearch",
			"space a a": "agent::ToggleFocus",
			"space e": [
				"task::Spawn",
				{
					"task_name": "Yazi",
					"reveal_target": "center"
				}
			],
			"space g g": [
				"task::Spawn",
				{
					"task_name": "Lazygit"
				}
			],
			"ctrl-\\": "workspace::ToggleBottomDock"
		}
	},
	{
		"context": "vim_mode == normal && !menu",
		"bindings": {}
	},
	{
		"context": "vim_mode == visual && !menu",
		"bindings": {
			"shift-k": "editor::MoveLineUp",
			"shift-j": "editor::MoveLineDown"
		}
	},
	{
		"context": "vim_mode == insert",
		"bindings": {
			"alt": "editor::ShowCompletions"
		}
	},
	{
		"context": "EmptyPane || SharedScreen",
		"bindings": {
			// Put key bindings here (in addition to the context above) if you want them to
			// work when no editor exists.
			// "space f": "file_finder::Toggle"
		}
	},
	{
		"context": "Dock",
		"bindings": {
			"ctrl h": "workspace::ActivatePaneLeft",
			"ctrl l": "workspace::ActivatePaneRight",
			"ctrl k": "workspace::ActivatePaneUp",
			"ctrl j": "workspace::ActivatePaneDown",
			"ctrl-q": "workspace::CloseAllDocks"
		}
	},
	{
		"context": "ProjectPanel && not_editing",
		"bindings": {
			"a": "project_panel::NewFile",
			"A": "project_panel::NewDirectory",
			"r": "project_panel::Rename",
			"d": "project_panel::Delete",
			"x": "project_panel::Cut",
			"c": "project_panel::Copy",
			"p": "project_panel::Paste",
			"l": "project_panel::Open",
			"h": "project_panel::UnfoldDirectory",
			// Close project panel as project file panel on the right
			"ctrl-q": "workspace::ToggleRightDock",
			"space e": "workspace::ToggleRightDock",
			// Navigate between panel
			"ctrl-h": "workspace::ActivatePaneLeft",
			"ctrl-l": "workspace::ActivatePaneRight",
			"ctrl-k": "workspace::ActivatePaneUp",
			"ctrl-j": "workspace::ActivatePaneDown"
		}
	},
	{
		"context": "Terminal",
		"bindings": {
			"ctrl-h": "workspace::ActivatePaneLeft",
			"ctrl-l": "workspace::ActivatePaneRight",
			"ctrl-k": "workspace::ActivatePaneUp",
			"ctrl-j": "workspace::ActivatePaneDown",
			"ctrl-\\": "workspace::ToggleBottomDock"
		}
	},
 {
  "context": "((VimControl && !menu) || (!Editor && !Terminal))",
  "bindings": {
   "space x": "pane::CloseActiveItem"
  }
 }
]
